<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12161E"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Live Controller HUD &amp; Debug"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_chevron_down"
        app:navigationIconTint="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <com.questgamepad.android.ui.QuestVisualControllerView
        android:id="@+id/debugVisualizer"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp" />

    <!-- Telemetry Stats Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#1A202C"
        app:strokeColor="#2D3748"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POLL RATE"
                    android:textColor="#718096"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPollRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90 Hz"
                    android:textColor="#00E5FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATTERY"
                    android:textColor="#718096"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDebugBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="L: 100% | R: 100%"
                    android:textColor="#7CD49B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE EMULATION"
                    android:textColor="#718096"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDebugProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DualSense PS5"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Raw Axes & State Log -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#0D1117"
        app:strokeColor="#21262D"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvRawOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Waiting for controller frames..."
                android:textColor="#58A6FF"
                android:textSize="12sp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
