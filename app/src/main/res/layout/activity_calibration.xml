<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12161E"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCalibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Stick &amp; Gyro Calibration"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_chevron_down"
        app:navigationIconTint="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stick Deadzones Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A202C"
                app:strokeColor="#2D3748"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Left Stick Radial Deadzone"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderLeftDeadzone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="30"
                            android:stepSize="1"
                            android:value="8"
                            app:thumbColor="#00E5FF"
                            app:trackColorActive="#00E5FF" />

                        <TextView
                            android:id="@+id/tvLeftDeadzoneVal"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:text="8%"
                            android:textColor="#00E5FF"
                            android:textSize="14sp"
                            android:gravity="end" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInvertLeftY"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Invert Left Stick Y-Axis"
                        android:textColor="#E2E8F0" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2D3748"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Right Stick Radial Deadzone"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderRightDeadzone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="30"
                            android:stepSize="1"
                            android:value="8"
                            app:thumbColor="#00E5FF"
                            app:trackColorActive="#00E5FF" />

                        <TextView
                            android:id="@+id/tvRightDeadzoneVal"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:text="8%"
                            android:textColor="#00E5FF"
                            android:textSize="14sp"
                            android:gravity="end" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInvertRightY"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Invert Right Stick Y-Axis"
                        android:textColor="#E2E8F0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Motion & Gyro Aiming Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A202C"
                app:strokeColor="#2D3748"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchGyroAiming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gyro_aiming"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMotionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motion_source_unavailable"
                        android:textColor="#A0AEC0"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gyro Aiming Sensitivity"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderGyroSens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.2"
                        android:valueTo="3.0"
                        android:stepSize="0.1"
                        android:value="1.0"
                        app:thumbColor="#00E5FF"
                        app:trackColorActive="#00E5FF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Haptic Vibration Feedback Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A202C"
                app:strokeColor="#2D3748"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Controller Haptic Rumble"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRumble"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="5"
                        android:value="100"
                        app:thumbColor="#00E5FF"
                        app:trackColorActive="#00E5FF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestRumble"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Test Vibration" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
